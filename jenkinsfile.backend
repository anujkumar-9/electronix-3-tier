pipeline {
    agent {
        label 'electronix'
    }

    environment {
        ECR_REPO      = '499989195637.dkr.ecr.us-east-1.amazonaws.com/electronix-ecr'
        AWS_REGION    = 'us-east-1'
        PRODUCTION_IP = '44.214.17.88'
    }

    stages {

        stage('Build Docker Image') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t electronix-backend:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REPO}
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                    docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:latest

                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:latest

                    echo "Pushed Successfully ✅"
                '''
            }
        }
    }

    post {
        success {
            echo "Docker image pushed to ECR successfully."
        }

        failure {
            echo "Pipeline failed."
        }
    }
}